# Local development - Next.js + Supabase
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://your-local-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-local-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-local-service-role-key

# Stripe (test mode)
STRIPE_SECRET_KEY=sk_test_your-local-secret-key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-local-publishable-key
STRIPE_WEBHOOK_SECRET=whsec_your-local-webhook-secret

# QR signing salt
QR_SALT=ticketing-ai-local-secret
